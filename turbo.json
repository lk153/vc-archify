{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["UPSTREAM.json", "pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../examples/**",
        "../../skills/vc-archify/**",
        "../../packages/render/src/**",
        "../../packages/browser-engine/**"
      ],
      "outputs": [".next/**", "!.next/cache/**", ".generated/**", "public/engine/**", "dist/**"],
      "env": ["NEXT_PUBLIC_SITE_URL", "GITHUB_TOKEN"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "../../examples/**", "../../skills/vc-archify/**", "../../design/**"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "../../examples/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
