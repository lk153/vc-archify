{
  "name": "@vca/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "examples": "node scripts/build-examples.mjs",
    "engine": "pnpm --filter @vca/browser-engine build",
    "dev": "pnpm run engine && node scripts/build-examples.mjs && next dev",
    "build": "pnpm run engine && node scripts/build-examples.mjs && next build",
    "start": "next start",
    "typecheck": "node scripts/build-examples.mjs && next typegen && tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vca/browser-engine": "workspace:*",
    "@vca/render": "workspace:*",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 ChromeAndroid versions",
    "last 2 Edge versions"
  ]
}
